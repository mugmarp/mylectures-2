<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Note attachments copied into files/attachments/ are exposed read-only
         to viewer apps via FileProvider so they can be opened or shared. -->
    <files-path
        name="attachments"
        path="attachments/" />
    <!-- Exposes downloaded update APKs in cache/updates/ via FileProvider to Android Package Installer -->
    <cache-path
        name="updates"
        path="updates/" />
</paths>
